! X colors.
! Generated by 'wal'
*foreground:        #cbc8c8
*background:        #302425
*.foreground:       #cbc8c8
*.background:       #302425
emacs*foreground:   #cbc8c8
emacs*background:   #302425
URxvt*foreground:   #cbc8c8
XTerm*foreground:   #cbc8c8
UXTerm*foreground:  #cbc8c8
URxvt*background:   [100]#302425
XTerm*background:   #302425
UXTerm*background:  #302425
URxvt*cursorColor:  #cbc8c8
XTerm*cursorColor:  #cbc8c8
UXTerm*cursorColor: #cbc8c8
URxvt*borderColor:  [100]#302425

! Colors 0-15.
*.color0: #302425
*color0:  #302425
*.color1: #75BDCE
*color1:  #75BDCE
*.color2: #C2AAB2
*color2:  #C2AAB2
*.color3: #E1A4AC
*color3:  #E1A4AC
*.color4: #EECEA8
*color4:  #EECEA8
*.color5: #9DDBDF
*color5:  #9DDBDF
*.color6: #DFD5DE
*color6:  #DFD5DE
*.color7: #cbc8c8
*color7:  #cbc8c8
*.color8: #7f686b
*color8:  #7f686b
*.color9: #75BDCE
*color9:  #75BDCE
*.color10: #C2AAB2
*color10:  #C2AAB2
*.color11: #E1A4AC
*color11:  #E1A4AC
*.color12: #EECEA8
*color12:  #EECEA8
*.color13: #9DDBDF
*color13:  #9DDBDF
*.color14: #DFD5DE
*color14:  #DFD5DE
*.color15: #cbc8c8
*color15:  #cbc8c8

! Black color that will not be affected by bold highlighting.
*.color66: #302425
*color66:  #302425

! Xclock colors.
XClock*foreground: #cbc8c8
XClock*background: #302425
XClock*majorColor:  rgba:cb/c8/c8/ff
XClock*minorColor:  rgba:cb/c8/c8/ff
XClock*hourColor:   rgba:cb/c8/c8/ff
XClock*minuteColor: rgba:cb/c8/c8/ff
XClock*secondColor: rgba:cb/c8/c8/ff

! Set depth to make transparency work.
URxvt*depth: 32
