{
    "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
    "name": "pywal",
    "author": "pywal",
    "themes": [
        {
            "name": "pywal",
            "appearance": "dark",
            "style": {
                "background": "#30242590",
                "editor.background": "#30242590",
                "editor.foreground": "#cbc8c8",
                "text": "#cbc8c8",
                "text.muted": "#cbc8c870",
                "text.ignored": "#cbc8c840",
                "text.placeholder": "#cbc8c850",
                "ignored": "#cbc8c830",
                "element.hover": "#cbc8c830",
                "ghost_element.hover": "#75BDCE30",
                "ghost_element.selected": "#75BDCE30",
                "ghost_element.active": "#75BDCE60",
                "border": "#302425",
                "editor.highlighted_line.background": "#75BDCE10",
                "editor.active_line.background": "#75BDCE10",
                "panel.background": "#30242590",
                "title_bar.background": "#30242590",
                "title_bar.inactive_background": "#30242590",
                "status_bar.background": "#30242590",
                "drop_target.background": "#30242590",
                "elevated_surface.background": "#302425",
                "toolbar.background": "#30242590",
                "tab_bar.background": "#30242590",
                "tab.inactive_background": "#30242590",
                "tab.active_background": "#75BDCE30",
                "scrollbar.track.background": "transparent",
                "scrollbar.track.border": "#302425",
                "scrollbar.thumb.background": "#75BDCE",
                "editor.gutter.background": "#30242590",
                "terminal.background": "#30242510",
                "terminal.foreground": "#cbc8c8",
                "terminal.dim_foreground": "#cbc8c8",
                "terminal.bright_foreground": "#cbc8c8",
                "terminal.ansi.black": "#302425",
                "terminal.ansi.red": "#75BDCE",
                "terminal.ansi.green": "#C2AAB2",
                "terminal.ansi.yellow": "#E1A4AC",
                "terminal.ansi.blue": "#EECEA8",
                "terminal.ansi.magenta": "#9DDBDF",
                "terminal.ansi.cyan": "#DFD5DE",
                "terminal.ansi.white": "#cbc8c8",
                "terminal.ansi.bright_black": "#7f686b",
                "terminal.ansi.bright_red": "#75BDCE",
                "terminal.ansi.bright_green": "#C2AAB2",
                "terminal.ansi.bright_yellow": "#E1A4AC",
                "terminal.ansi.bright_blue": "#EECEA8",
                "terminal.ansi.bright_magenta": "#9DDBDF",
                "terminal.ansi.bright_cyan": "#DFD5DE",
                "terminal.ansi.bright_white": "#cbc8c8",
                "modified": "#75BDCE",
                "syntax": {
                    "attribute": {
                        "color": "#75BDCE"
                    },
                    "boolean": {
                      "color": "#C2AAB2"
                    },
                    "comment": {
                      "color": "#7f686b"
                    },
                    "comment.doc": {
                      "color": "#7f686b"
                    },
                    "constant": {
                      "color": "#C2AAB2"
                    },
                    "function": {
                      "color": "#DFD5DE"
                    },
                    "keyword": {
                      "color": "#EECEA8"
                    },
                    "number": {
                      "color": "#9DDBDF"
                    },
                    "operator": {
                      "color": "#EECEA8"
                    },
                    "string": {
                      "color": "#75BDCE"
                    },
                    "variable": {
                      "color": "#C2AAB2"
                    }
                },
                "players": [
                  {
                    "cursor": "#75BDCE",
                    "background": "#302425",
                    "selection": "#75BDCE30"
                  }
                ]
            }
        }
    ]
}
